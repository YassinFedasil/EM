# Copy to .env and adjust for docker-compose.
# MongoDB root credentials (initialised on first container start).
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123

# Connection string used by the backend container.
MONGO_URL=mongodb://admin:admin123@euro_stat_db:27017/euro_stat_db?authSource=admin

# Backend base URL baked into the frontend build (browser-side).
VITE_API_URL=http://localhost:8000
